# Directorios de dependencias
node_modules
.next/        # Directorio de build de Next.js
out/         # Directorio de exportación estática de Next.js (si lo usas)
dist/        # Directorio de distribución general (ej. si compilas TypeScript para una librería)
build/       # Directorio de build general

# Archivos de log
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Archivos de configuración de entorno (variables de entorno sensibles)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging.local

# Archivos de caché
.DS_Store                  # macOS
*.tgz
.yarn/                     # Directorio de caché de Yarn
.cache/                    # Caché de Next.js u otras herramientas
.next/cache/               # Caché específico de Next.js
.eslintcache               # Caché de ESLint
.firebase/                 # Caché de Firebase CLI

# IDEs y editores
.vscode/                   # Configuraciones de VS Code (opcional, si es personal y no de proyecto)
.idea/                     # IntelliJ IDEA
*.sublime-project
*.sublime-workspace

# Varios
.local/
.npm/

# Firebase
firebase-debug.log
firebase-debug.*.log
.firebase/
# `firebase-admin.json` o cualquier otro archivo de credenciales de servicio, si lo usas directamente en el código
# ¡MUY IMPORTANTE! NO SUBIR ARCHIVOS CON CLAVES SENSIBLES.
# Si tienes un archivo con credenciales de Firebase Admin SDK (ej. una cuenta de servicio),
# asegúrate de que esté listado aquí si se usa localmente y no debe ir al repo.
# Por ejemplo: my-firebase-admin-sdk-key.json

# Directorio de Cloud Functions (si tienes un node_modules dentro de functions/)
functions/node_modules/
functions/lib/ # Si Cloud Functions se compilan a JS aquí

# Archivos de TypeScript (archivos .js y .js.map generados)
*.js
*.js.map
!*.spec.js # Si tienes tests en .js y quieres incluirlos.
!*.d.ts    # Si tienes archivos de definición de tipos y quieres incluirlos.

# Archivos temporales
*.tmp
*.bak
