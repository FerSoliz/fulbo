rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite que cualquier usuario autenticado pueda leer y escribir en CUALQUIER ruta de Storage
    // ADVERTENCIA DE SEGURIDAD CRÍTICA: ESTAS REGLAS SON DEMASIADO PERMISIVAS PARA PRODUCCIÓN.
    // DEBES REEMPLAZARLAS CON REGLAS MÁS SEGURAS ANTES DE IR A PRODUCCIÓN PARA CADA RUTA.
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
