rules_version = '2';

// Le decimos a Firebase que estas reglas son para el servicio de Storage.
service firebase.storage {
  // Las reglas se aplican a nuestro "bucket" (el contenedor principal de archivos).
  match /b/{bucket}/o {

    // --- REGLAS PARA PUBLICACIONES (/posts) ---
    // Esta regla se aplica a cualquier archivo dentro de una carpeta de usuario en /posts.
    // ej: /posts/USER_ID_123/imagen.jpg
    match /posts/{userId}/{allPaths=**} {
      
      // PERMISO DE LECTURA (READ)
      // Cualquiera puede ver las imágenes de las publicaciones.
      // Esto es necesario para que los posts sean públicos.
      allow read;

      // PERMISO DE ESCRITURA (WRITE)
      // `write` incluye crear, actualizar y eliminar.
      // Solo permitimos la escritura si se cumplen DOS condiciones:
      // 1. El usuario está autenticado (`request.auth != null`).
      // 2. El ID del usuario autenticado (`request.auth.uid`) es el mismo
      //    que el de la carpeta donde intenta escribir (`userId`).
      // Esto evita que un usuario pueda subir/borrar archivos en la carpeta de otro.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // --- REGLAS PARA FOTOS DE PERFIL (/avatars) ---
    // Similar a las publicaciones, pero para la carpeta de avatares.
    match /avatars/{userId}/{allPaths=**} {
      
      // Cualquiera puede ver las fotos de perfil.
      allow read;

      // Solo el dueño del perfil puede cambiar su propia foto.
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Podríamos añadir más reglas aquí para la tienda, etc.
    // match /products/{productId} {
    //   allow read;
    //   allow write: if request.auth != null && request.auth.uid == 'ADMIN_USER_ID';
    // }
  }
}
