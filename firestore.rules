rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Regla para la colección de usuarios
    // Un usuario solo puede leer y escribir en su propio documento
    // Los administradores pueden leer y escribir en todos los documentos de usuario
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow create: if request.auth != null && request.auth.uid == userId; // Solo crear su propio perfil
      allow update: if request.auth != null && request.auth.uid == userId && (
        // Permitir actualizar campos específicos, pero no el rol por sí mismo desde el cliente
        // Si el rol debe ser modificado, debe ser a través de un admin.
        // Aquí puedes listar los campos que SÍ pueden actualizar:
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'username', 'avatar', 'location', 'profileBackground', 'dni'])
        // Si hay otros campos que el usuario puede actualizar, añádelos aquí.
        // Por ahora, solo permitimos cambios en nombre, username, avatar, location, profileBackground, dni
      ) || (request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      allow delete: if false; // Los usuarios no pueden eliminar sus propios perfiles directamente desde la app
    }

    // Regla para la colección de posts
    match /posts/{postId} {
      // Todos pueden leer los posts
      allow read: if true;

      // Solo administradores y capitanes pueden crear posts
      // El authorId del post debe coincidir con el uid del usuario que lo crea
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'captain'
      );

      // Solo administradores y el autor original pueden actualizar o eliminar un post
      allow update, delete: if request.auth != null && (
        request.resource.data.authorId == request.auth.uid || // El autor puede actualizar/eliminar su propio post
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' // Un admin puede actualizar/eliminar cualquier post
      );
    }

    // Regla por defecto para cualquier otra colección (denegar todo por seguridad)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
