rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para la colección 'users'
    // Cualquiera puede crear su propio perfil de usuario al registrarse.
    // Solo el propio usuario o un admin puede leer o actualizar sus datos.
    match /users/{userId} {
      allow read, update: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow create: if request.auth.uid == userId;
    }

    // Reglas para la colección 'posts'
    // Cualquiera puede leer los posts.
    match /posts/{postId} {
      allow read: if true;
      
      // Solo usuarios con rol 'admin' o 'captain' pueden crear posts.
      // Además, validamos que los datos que llegan son correctos.
      allow create: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'captain')
                    && request.resource.data.title is string
                    && request.resource.data.content is string
                    && request.resource.data.authorId == request.auth.uid;

      // Solo el autor original del post o un admin puede actualizarlo o borrarlo.
      allow update, delete: if request.auth != null && (resource.data.authorId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // --- Placeholder para otras colecciones (¡Debemos definirlas!) ---
    // Es importante añadir reglas para el resto de colecciones:
    // teams, tournaments, registrations, matches, etc.
    // Por ahora, denegaremos el acceso por defecto para ser seguros.
    match /{document=**} {
        allow read, write: if false;
    }
  }
}
