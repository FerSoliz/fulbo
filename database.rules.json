{
  "rules": {
    ".read": false,
    ".write": false,
    "products": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "guestPlayers": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'captain')"
    },
    "match_stats": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "matches": {
      ".indexOn": [
        "teamAId",
        "teamBId",
        "tournamentId",
        "homeTeamId",
        "awayTeamId",
        "status"
      ],
      ".read": "auth != null",
      "$matchId": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "playerStats": {
      "$userId": {
        ".read": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "posts": {
      ".read": true,
      "$postId": {
        ".validate": "newData.hasChildren(['authorId', 'authorName', 'authorAvatar', 'authorUsername', 'createdAt']) && newData.child('authorId').isString() && newData.child('authorName').isString() && newData.child('authorAvatar').isString() && newData.child('authorUsername').isString() && (newData.hasChild('content') && newData.child('content').isString() && newData.child('content').val().length > 0 || newData.hasChild('media'))",
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'captain')) || (data.exists() && (data.child('authorId').val() === auth.uid || root.child('users').child(auth.uid).child('role').val() === 'admin')))",
        "authorAvatar": {
          ".validate": "newData.isString()"
        },
        "authorId": {
          ".validate": "newData.isString()"
        },
        "authorName": {
          ".validate": "newData.isString()"
        },
        "authorUsername": {
          ".validate": "newData.isString()"
        },
        "comments": {
          "$commentId": {
            ".validate": "newData.hasChildren(['authorId', 'authorName', 'authorAvatar', 'authorUsername', 'content', 'createdAt']) && newData.child('authorId').isString() && newData.child('authorName').isString() && newData.child('authorAvatar').isString() && newData.child('authorUsername').isString() && newData.child('content').isString() && newData.child('content').val().length > 0 && newData.child('content').val().length <= 200 && (newData.child('createdAt').isNumber() || newData.child('createdAt').hasChild('.sv'))",
            ".write": "auth != null && ((newData.hasChild('authorId') && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin' )"
          }
        },
        "content": {
          ".validate": "newData.isString() && newData.val().length <= 500"
        },
        "createdAt": {
          ".validate": "(newData.isNumber() || newData.hasChild('.sv'))"
        },
        "isPinned": {
          ".validate": "newData.isBoolean() || newData.val() === null"
        },
        "likes": {
          "$uid": {
            ".validate": "newData.hasChildren(['name', 'avatar', 'username']) && newData.child('name').isString() && newData.child('avatar').isString() && newData.child('username').isString() || newData.val() === null",
            ".write": "auth != null && auth.uid === $uid"
          }
        },
        "media": {
          ".validate": "newData.hasChildren()"
        },
        "pinnedUntil": {
          ".validate": "newData.isString() || newData.val() === null"
        },
        "url": {
          ".validate": "newData.isString() || newData.val() === null"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "teams": {
      ".indexOn": "name",
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$teamId": {
        "players": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'captain')"
        }
      }
    },
    "tournament_stats": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "tournaments": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "users": {
      ".indexOn": [
        "dni",
        "sudpoints"
      ],
      ".read": true,
      "$userId": {
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "newData.isString() && (newData.val() === 'player' || newData.val() === 'captain' || newData.val() === 'admin')"
        },
        "username": {
          ".validate": "newData.isString() && newData.val().length > 0"
        }
      }
    }
  }
}