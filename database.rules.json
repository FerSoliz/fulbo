{
  "rules": {
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid == $uid",
        "role": { ".validate": "newData.isString() && (newData.val() == 'player' || newData.val() == 'captain' || newData.val() == 'admin')" },
        "name": { ".validate": "newData.isString() && newData.val().length > 0" }
      }
    },
    "posts": {
      ".read": "true",
      ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() == 'admin' || root.child('users/' + auth.uid + '/role').val() == 'captain')",
      "$postId": {
        ".validate": "newData.hasChildren(['authorId', 'content', 'createdAt']) && newData.child('authorId').val() == auth.uid",
        "authorId": { ".validate": "newData.isString() && newData.val().length > 0" },
        "content": { ".validate": "newData.isString() && newData.val().length > 0" },
        "createdAt": { ".validate": "newData.isString()" },
        "media": { ".validate": "newData.isBoolean() || newData.isNumber() || newData.isString() || newData.isMap()"},
        "url": { ".validate": "newData.isString() || !newData.exists()" },
        "isPinned": { ".validate": "newData.isBoolean() || !newData.exists()" },
        "pinnedUntil": { ".validate": "newData.isString() || !newData.exists()" },
        "likes": {
          ".write": "auth != null",
          "$uid": { ".validate": "newData.isBoolean()" }
        },
        "comments": {
          ".write": "auth != null && (root.child('users/' + auth.uid + '/role').val() == 'admin' || root.child('users/' + auth.uid + '/role').val() == 'captain')",
          "$commentId": {
            ".validate": "newData.hasChildren(['authorId', 'content', 'createdAt']) && newData.child('authorId').val() == auth.uid",
            "authorId": { ".validate": "newData.isString() && newData.val().length > 0" },
            "content": { ".validate": "newData.isString() && newData.val().length > 0" },
            "createdAt": { ".validate": "newData.isString()" }
          }
        }
      }
    },
    "matches": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() == 'admin'",
      "$matchId": {
        ".validate": "newData.hasChildren(['id', 'tournamentId', 'round', 'homeTeamId', 'awayTeamId', 'status'])"
      }
    },
    ".read": "false",
    ".write": "false"
  }
}
