{
  "rules": {
    "users": {
      ".indexOn": ["dni"],
      ".read": "auth != null", // Solo usuarios autenticados pueden leer la colección 'users'
      "$userId": {
        ".write": "auth != null && (auth.uid === $userId || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "username": { ".validate": "newData.isString() && newData.val().length > 0" },
        "role": { ".validate": "newData.isString() && (newData.val() === 'player' || newData.val() === 'captain' || newData.val() === 'admin')" }
      }
    },
    "posts": {
      ".read": true, // Cualquiera (autenticado o no) puede leer la colección 'posts'
      "$postId": {
        ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        // Validamos que los nuevos campos desnormalizados existan y sean strings
        ".validate": "newData.hasChildren(['authorId', 'authorName', 'authorAvatar', 'authorUsername', 'content', 'createdAt'])",
        "authorId": { ".validate": "newData.isString()" },
        "authorName": { ".validate": "newData.isString() && newData.val().length > 0" },
        "authorAvatar": { ".validate": "newData.isString() && newData.val().length > 0" },
        "authorUsername": { ".validate": "newData.isString() && newData.val().length > 0" },
        "content": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500" },
        "createdAt": { ".validate": "newData.isString()" },
        "likes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.isBoolean() || newData.val() === null"
          }
        },
        "comments": {
          "$commentId": {
            ".write": "auth != null && ((!data.exists() && newData.child('authorId').val() === auth.uid) || (data.exists() && data.child('authorId').val() === auth.uid) || root.child('users').child(auth.uid).child('role').val() === 'admin')",
            ".validate": "newData.hasChildren(['authorId', 'content', 'createdAt'])",
            "authorId": { ".validate": "newData.isString()" },
            "content": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" }
          }
        },
        "media": { ".validate": "newData.hasChildren() || newData.val() === null" },
        "url": { ".validate": "newData.isString() || newData.val() == null" },
        "isPinned": { ".validate": "newData.isBoolean() || newData.val() == null" },
        "pinnedUntil": { ".validate": "newData.isString() || newData.val() == null" },
        "$other": { ".validate": false }
      }
    },
    "guestPlayers": {
      ".read": "auth != null",
      ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'captain')"
    },
    "tournaments": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "teams": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'",
      "$teamId": {
        "players": {
          ".write": "auth != null && (root.child('users').child(auth.uid).child('role').val() === 'admin' || root.child('users').child(auth.uid).child('role').val() === 'captain')"
        }
      }
    },
    "matches": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "match_stats": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "tournament_stats": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    ".read": "auth != null", // Regla global: por defecto, solo usuarios autenticados pueden leer
    ".write": false
  }
}